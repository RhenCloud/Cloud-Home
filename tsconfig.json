{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "vueCompilerOptions": {
    "globalTypesPath": "./node_modules/.vue-global-types"
  },
  "include": [
    "./.nuxt/nuxt.node.d.ts",
    "nuxt.config.ts",
    "app/**/*.ts",
    "app/**/*.vue",
    "app/**/*.d.ts",
    "server/**/*.ts"
  ]
}
